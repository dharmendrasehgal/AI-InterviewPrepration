# ─── Interview Preparation Platform — Local Dev Environment ────
# Copy this file to .env and fill in the required values:
#   cp .env.example .env
#
# NEVER commit .env to source control.

# ── Required ────────────────────────────────────────────────────

# Anthropic Claude API key — get yours at: https://console.anthropic.com
# Format: sk-ant-api03-<40 chars>-<80 chars>-<13 chars>
# Sample (non-functional, for format reference only):
CLAUDE_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX-XXXXXXXXXXXXX

# AES-256-GCM field encryption key — must be exactly 64 hex characters (32 bytes)
# Generate a secure random key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DO NOT use the zero-filled example below in production:
FIELD_ENCRYPTION_KEY=83acd9915c0febe9dd0d578e63a7020103c25592498720cf2292b27ca105f4cb

# PostgreSQL password — used by api, worker, and postgres services
POSTGRES_PASSWORD=dev_password_change_me

# ── Recommended (safe defaults for dev, must be changed for production) ──────

# JWT refresh token signing secret — minimum 32 random characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_prod

# SendGrid API key — leave blank to skip email sending in dev
SENDGRID_API_KEY=

# ── Setup steps ─────────────────────────────────────────────────
#
# 1. Fill in CLAUDE_API_KEY and FIELD_ENCRYPTION_KEY above, then save as .env
#
# 2. Generate the JWT RSA private key via Docker (requires Docker running):
#      docker compose run --rm keygen
#    OR generate locally if openssl is installed:
#      openssl genrsa -out jwt_private_key.pem 2048
#    The key file is git-ignored — never commit it.
#
# 3. Install backend dependencies (generates package-lock.json):
#      cd ../backend && npm install && cd ../devops
#
# 4. Start the full stack:
#      docker compose up -d
#
# 5. Verify all services are healthy:
#      docker compose ps
#      curl http://localhost:3001/health
