# ─── Interview Prep Platform — Frontend Environment ─────────────
# Copy to .env.local and fill in values:
#   cp .env.local.example .env.local
#
# NEVER commit .env.local to source control.

# ── Required ─────────────────────────────────────────────────────

# URL of the Fastify API (no trailing slash)
# Local dev: http://localhost:3001
# Production: https://api.platform.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Setup steps ──────────────────────────────────────────────────
#
# 1. Copy this file:
#      cp .env.local.example .env.local
#
# 2. Install dependencies:
#      npm install
#
# 3. Start the API stack first:
#      cd ../devops && docker compose up -d && cd ../frontend
#
# 4. Start the dev server:
#      npm run dev
#
# 5. Open http://localhost:3000
