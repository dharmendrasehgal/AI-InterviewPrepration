{
  "name": "interview-prep-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsup server.ts worker.ts --format cjs --out-dir dist --no-splitting --sourcemap",
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "worker": "node dist/worker.js",
    "worker:dev": "tsx watch worker.ts",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.99.0",
    "@aws-sdk/client-s3": "^3.1054.0",
    "@aws-sdk/s3-request-presigner": "^3.1054.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.77.4",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "pino": "^9.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^5.7.0",
    "vitest": "^4.1.7"
  }
}
